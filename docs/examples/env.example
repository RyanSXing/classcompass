# Copy to the application root as .env.example during implementation.
# Defaults intentionally run locally with prepared, labeled model fixtures.
APP_DEPLOYMENT=local
DATA_BACKEND=local
AI_MODE=fixture
LOCAL_DATA_DIR=.local/classcompass

# Needed only for AI_MODE=live. Server only; never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_REASONING_MODEL=deepseek/deepseek-v4-flash-0731:free
AI_CALL_TIMEOUT_MS=75000
AI_MAX_ATTEMPTS=3

# Needed for DATA_BACKEND=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only for an explicit seed/provisioning command; ordinary routes use user scope.
SUPABASE_SECRET_KEY=

APP_BASE_URL=http://127.0.0.1:3000
DEMO_TEACHING_TIMEZONE=America/Chicago
